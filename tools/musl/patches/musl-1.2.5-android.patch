--- musl-1.2.5.orig/src/linux/setgroups.c	2024-03-01 02:07:33.000000000 +0000
+++ musl-1.2.5/src/linux/setgroups.c	2026-11-25 16:23:23.948200811 +0000
@@ -26,8 +26,25 @@
 	c->ret = ret;
 }
 
+/* See setxid.c: setgroups is on the same Android blocklist. Installing the
+ * list that is already in place is answered without a syscall. */
+static int is_noop(size_t count, const gid_t list[])
+{
+	gid_t cur[64];
+	size_t i, j;
+	int n = __syscall(SYS_getgroups, 64, cur);
+
+	if (n < 0 || (size_t)n != count) return 0;
+	for (i = 0; i < count; i++) {
+		for (j = 0; j < count && cur[j] != list[i]; j++);
+		if (j == count) return 0;
+	}
+	return 1;
+}
+
 int setgroups(size_t count, const gid_t list[])
 {
+	if (is_noop(count, list)) return 0;
 	/* ret is initially nonzero so that failure of the first thread does not
 	 * trigger the safety kill above. */
 	struct ctx c = { .count = count, .list = list, .ret = 1 };
