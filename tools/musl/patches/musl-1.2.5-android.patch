 }
 
+/* The Android app seccomp filter kills (SIGSYS) a process that issues any
+ * set*id syscall, even one that would change nothing. "Drop privileges to
+ * the ids I already have" is a common idiom, so answer it without a syscall. */
+static int is_noop(int nr, int id, int eid, int sid)
+{
+	unsigned r, e, s;
+
+	switch (nr) {
+	case SYS_setuid:
+	case SYS_setreuid:
+	case SYS_setresuid:
+		if (__syscall(SYS_getresuid, &r, &e, &s)) return 0;
+		break;
+	case SYS_setgid:
+	case SYS_setregid:
+	case SYS_setresgid:
+		if (__syscall(SYS_getresgid, &r, &e, &s)) return 0;
+		break;
+	default:
+		return 0;
+	}
+	if (r != e || e != s) return 0;
+
+	switch (nr) {
+	case SYS_setuid:
+	case SYS_setgid:
+		return (unsigned)id == r;
+	case SYS_setreuid:
+	case SYS_setregid:
+		return (id == -1 || (unsigned)id == r)
+			&& (eid == -1 || (unsigned)eid == r);
+	default:
+		return (id == -1 || (unsigned)id == r)
+			&& (eid == -1 || (unsigned)eid == r)
+			&& (sid == -1 || (unsigned)sid == r);
+	}
+}
+
 int __setxid(int nr, int id, int eid, int sid)
 {
+	if (is_noop(nr, id, eid, sid)) return 0;
 	/* ret is initially nonzero so that failure of the first thread does not
 	 * trigger the safety kill above. */
 	struct ctx c = { .nr = nr, .id = id, .eid = eid, .sid = sid, .ret = 1 };
