diff -ruN musl-1.2.5.orig/src/internal/android_sandbox.h musl-1.2.5/src/internal/android_sandbox.h
--- musl-1.2.5.orig/src/internal/android_sandbox.h	1970-01-01 00:00:00.000000000 +0000
+++ musl-1.2.5/src/internal/android_sandbox.h	2026-11-25 16:23:23.948200811 +0000
@@ -0,0 +1,14 @@
+#ifndef ANDROID_SANDBOX_H
+#define ANDROID_SANDBOX_H
+
+#include <errno.h>
+#include "syscall.h"
+
+/* Root-only syscalls are on the Android app seccomp blocklist: issuing one
+ * raises SIGSYS instead of failing. An unprivileged caller would get EPERM
+ * from the kernel anyway, so report that without entering the kernel. */
+#define DENY_UNLESS_ROOT() do { \
+	if (__syscall(SYS_geteuid)) return __syscall_ret(-EPERM); \
+} while (0)
+
+#endif
diff -ruN musl-1.2.5.orig/src/internal/etc_path.c musl-1.2.5/src/internal/etc_path.c
--- musl-1.2.5.orig/src/internal/etc_path.c	1970-01-01 00:00:00.000000000 +0000
+++ musl-1.2.5/src/internal/etc_path.c	2026-11-25 16:23:23.944200811 +0000
@@ -0,0 +1,31 @@
+#include <stdlib.h>
+#include <string.h>
+#include "libc.h"
+#include "etc_path.h"
+
+const char *__etc_path(const char *def, char *buf)
+{
+	const char *dir, *name;
+	size_t dl, nl;
+
+	if (libc.secure) return def;
+	dir = getenv("MUSL_ETC");
+	if (!dir || dir[0] != '/') return def;
+	name = strrchr(def, '/');
+	dl = strlen(dir);
+	nl = strlen(name);
+	if (dl + nl >= ETC_PATH_MAX) return def;
+	memcpy(buf, dir, dl);
+	memcpy(buf + dl, name, nl + 1);
+	return buf;
+}
+
+const char *__shell_path(void)
+{
+	const char *sh;
+
+	if (libc.secure) return "/bin/sh";
+	sh = getenv("MUSL_SHELL");
+	if (!sh || sh[0] != '/') return "/bin/sh";
+	return sh;
+}
diff -ruN musl-1.2.5.orig/src/internal/etc_path.h musl-1.2.5/src/internal/etc_path.h
--- musl-1.2.5.orig/src/internal/etc_path.h	1970-01-01 00:00:00.000000000 +0000
+++ musl-1.2.5/src/internal/etc_path.h	2026-11-25 16:23:23.944200811 +0000
@@ -0,0 +1,17 @@
+#ifndef ETC_PATH_H
+#define ETC_PATH_H
+
+#include <features.h>
+
+/* Android has no /etc. When MUSL_ETC names a directory, the files libc
+ * normally reads from /etc (resolv.conf, hosts, services, passwd, group)
+ * are looked up there instead. Ignored for set-id programs. */
+#define ETC_PATH_MAX 256
+
+hidden const char *__etc_path(const char *def, char *buf);
+
+/* Shell used by system(), popen() and wordexp(). MUSL_SHELL overrides
+ * /bin/sh, which does not exist before Android 9. */
+hidden const char *__shell_path(void);
+
+#endif
